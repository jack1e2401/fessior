{
  "name": "ocj-monorepo",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "npm run dev:hybrid",
    "dev:apps": "turbo run dev --filter=web --filter=api --filter=judge-worker --concurrency 15",
    "dev:local": "npm run dev:prepare && npm run dev:apps",
    "dev:hybrid": "docker compose -f infra/docker-compose.yml up -d --remove-orphans --wait --wait-timeout 120 mysql redis judge0-server judge0-workers && npm run dev:local",
    "dev:prepare": "npm run db:generate && npm run db:push && npm run build:packages",
    "dev:docker": "docker compose -f infra/docker-compose.yml up -d --build --remove-orphans --wait --wait-timeout 120",
    "build:packages": "turbo run build --filter=@ocj/contracts --filter=@ocj/executor --output-logs=errors-only",
    "db:generate": "node scripts/generate-prisma-client.cjs",
    "db:push": "node scripts/push-prisma-schema.cjs",
    "lint": "turbo run lint",
    "seed": "npm --workspace api run seed",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.0.0",
    "turbo": "2.10.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  }
}
