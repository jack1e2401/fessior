# Application Configuration
NODE_ENV=development
PORT=6868
DATABASE_URL=mysql://root:ocj_root_secret@localhost:3307/ocj_main_db
REDIS_HOST=localhost
REDIS_PORT=6379
JUDGE0_URL=http://localhost:2358

# JWT Security Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_at_least_32_characters_long

# MySQL Database Configuration (Docker Compose)
MYSQL_ROOT_PASSWORD=ocj_root_secret
MYSQL_DATABASE=ocj_main_db
MYSQL_USER=ocj_user
MYSQL_PASSWORD=ocj_secret_pass
