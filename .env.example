# Application Configuration
NODE_ENV=development
PORT=6868
DATABASE_URL=mysql://root:ocj_root_secret@localhost:3307/ocj_main_db
REDIS_HOST=localhost
REDIS_PORT=6379
SUBMISSION_RECONCILE_INTERVAL_MS=30000
SUBMISSION_RECONCILE_STALE_MS=60000
SUBMISSION_RECONCILE_BATCH_SIZE=50
JUDGE0_URL=http://localhost:2358

# JWT Security Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your_jwt_access_secret_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_must_be_at_least_32_characters_long

# Password recovery email (Gmail App Password; keep real credentials only in .env)
APP_PUBLIC_URL=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=

# MySQL Database Configuration (Docker Compose)
MYSQL_ROOT_PASSWORD=ocj_root_secret
MYSQL_DATABASE=ocj_main_db
MYSQL_USER=ocj_user
MYSQL_PASSWORD=ocj_secret_pass
